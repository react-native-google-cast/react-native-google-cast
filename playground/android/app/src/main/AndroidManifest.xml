<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33) suppresses notifications unless this is declared AND
         granted at runtime. The library deliberately declares no permissions of
         its own, and CAF >= 21.3.0 posts cast notifications via
         NotificationManager (no foreground service), so this is the permission
         that actually gates the Cast media notification. The example has no
         runtime prompt — grant it with
         `adb shell pm grant com.reactnative.googlecast.playground android.permission.POST_NOTIFICATIONS`
         before the Phase 6 notification rows. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Google Cast: the library OptionsProvider (v4-parity notifications,
           image picker, expanded controller). Mirrors the Expo plugin output
           (explicit here to exercise the meta-data read path);
           NitroExpandedControllerActivity is auto-registered by the library
           manifest — no manual <activity> needed.

           EA48D3FC is the project's own PUBLISHED custom receiver, hosted from
           this repo — see docs/internal/cast-receiver/README.md. The playground
           needs it because the Default Media Receiver (CC1AD845) structurally
           cannot answer a custom namespace, so the CastChannel rows have
           nothing to test against; being published, it launches on any
           Chromecast with no device registration.

           This is a PLAYGROUND choice, not the one to copy: a consumer app
           should use CC1AD845 unless it owns a receiver. Keep example/ (when
           it exists) on the Default Media Receiver. -->
      <meta-data
        android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
        android:value="com.margelo.nitro.googlecast.NitroCastOptionsProvider" />
      <meta-data
        android:name="com.margelo.nitro.googlecast.RECEIVER_APPLICATION_ID"
        android:value="EA48D3FC" />
    </application>
</manifest>
