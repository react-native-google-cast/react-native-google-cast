# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CastPlayground' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Native unit tests for the NitroGoogleCast struct↔GCK converters (Phase 2 / T1).
  # Hosted by the app target; `:search_paths` reuses the host app's statically linked
  # pods (NitroGoogleCast + GoogleCast) without re-linking them.
  target 'NitroGoogleCastTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Layer an optional, untracked `ios/local.xcconfig` on top of the generated
    # app xcconfigs. This is how the Phase 6 device pass selects build B
    # (discovery autostart) and supplies device-signing settings without any
    # source or `project.pbxproj` edit — see ios/local.xcconfig.example.
    #
    # `#include?` is the optional form: absent file → build unchanged (build A,
    # what CI and the Simulator gate compile). Appended last so local values win
    # over the CocoaPods defaults.
    Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-CastPlayground', '*.xcconfig')).each do |xcconfig|
      contents = File.read(xcconfig)
      next if contents.include?('local.xcconfig')
      File.write(xcconfig, contents + <<~INCLUDE)

        // Optional local overrides (untracked) — see ios/local.xcconfig.example
        #include? "../../../local.xcconfig"
      INCLUDE
    end
  end
end
