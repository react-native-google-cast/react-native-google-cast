{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "chromecast-caf-sender"],
    "paths": {
      "react-native": ["./node_modules/react-native-web"],
      "react-native-google-cast": ["../src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src", "vite.config.ts"]
}
